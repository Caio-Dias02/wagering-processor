# Exemplo de configuração. Opcional: todos os valores abaixo já são o padrão do código
# para o ambiente local do `docker compose up -d`. Para mudar algo, copie para `.env`
# (o Bun lê automaticamente) e ajuste. O `.env` não vai para o git.
# No `docker compose --profile app`, as variáveis vêm do próprio docker-compose.yml.

# HTTP
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
# Conexões por instância (teto de transações simultâneas)
DATABASE_POOL_MAX=10

# SQS (LocalStack aceita qualquer credencial; em produção viriam do ambiente/IAM role)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
# Sem valor = usa o da fila (30 s)
# SQS_VISIBILITY_TIMEOUT_SECONDS=30

# Workers (todos ligados por padrão; cada instância roda todos)
SQS_CONSUMER_ENABLED=true
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
RECONCILIATION_WORKER_ENABLED=true
# Intervalo entre varreduras, somando todas as instâncias (1 h)
RECONCILIATION_INTERVAL_MS=3600000
RECONCILIATION_POLL_INTERVAL_MS=60000

# Logs: debug | info | warn | error | silent
LOG_LEVEL=info

# Teste de carga (`bun run test:load`), só para o script; descomente para mudar
# LOAD_TARGETS=http://localhost:3000
# LOAD_WALLETS=20
# LOAD_TRANSACTIONS=2000
# LOAD_CONCURRENCY=50
# LOAD_DUPLICATE_RATIO=0.1
# LOAD_INITIAL_BALANCE=1000.00
# LOAD_PENDING_TIMEOUT_MS=90000
# LOAD_SEED=42
